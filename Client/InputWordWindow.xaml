<Window x:Class="Client.InputWordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="Zure Txanda!" Height="250" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" Background="#252526" BorderBrush="#00ADB5" BorderThickness="2">
    <StackPanel VerticalAlignment="Center" Margin="20">
        <TextBlock Text="ZURE TXANDA DA!" 
                   Foreground="#00ADB5" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock Text="Idatzi zure hitza (Gogoratu ez oparitu!):" 
                   Foreground="White" 
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBox x:Name="txtWord" 
                 Height="40" 
                 FontSize="16"
                 VerticalContentAlignment="Center"
                 Padding="5"
                 Background="#333333" 
                 Foreground="White" 
                 BorderBrush="Gray"
                 KeyDown="TxtWord_KeyDown"/>

        <Button x:Name="btnSend" 
                Content="BIDALI" 
                Height="40" 
                Margin="0,20,0,0"
                Background="#00ADB5" 
                Foreground="White" 
                FontWeight="Bold"
                BorderThickness="0"
                Click="BtnSend_Click"/>
    </StackPanel>
</Window>
