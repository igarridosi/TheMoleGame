<Window x:Class="Client.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="Nire Estatistikak" Height="450" Width="700" Background="#1E1E1E">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Ezkerra: Profila -->
            <ColumnDefinition Width="*"/>
            <!-- Eskuma: Datuak -->
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- EZKERRA: PROFILA ETA ROLE -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="#252526" BorderBrush="#333" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Center">

                <!-- Avatar Zirkulua -->
                <Border Width="100" Height="100" CornerRadius="50" Background="#333333" BorderBrush="#00ADB5" BorderThickness="2" Margin="0,0,0,15">
                    <TextBlock Text="👤" FontSize="60" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="White" Margin="9,0,0,7"/>
                </Border>
                <TextBlock x:Name="lblUsername" Text="Erabiltzailea" FontSize="20" FontWeight="Bold" Foreground="#00ADB5" HorizontalAlignment="Center"/>
                <TextBlock Text="JOKALARIA" Foreground="Gray" HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- ESKUMA: DATUAK ETA METRIKAK -->
        <!-- ========================================================= -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">

                <!-- 1. ATALA: HISTORIAL OROKORRA -->
                <TextBlock Text="JOKOAREN HISTORIALA" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Opacity="0.8"/>

                <Grid Margin="0,0,0,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- PARTIDAK -->
                    <Border Grid.Column="0" Background="#2D2D2D" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="PARTIDAK" Foreground="Gray" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="txtGames" Text="0" Foreground="White" FontSize="40" FontWeight="Black" Margin="0,10,0,0"/>
                            <TextBlock Text="Guztira" Foreground="#555" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- GARAIPENAK -->
                    <Border Grid.Column="1" Background="#2D2D2D" CornerRadius="8" Padding="20" Margin="5,0,5,0">
                        <StackPanel>
                            <TextBlock Text="GARAIPENAK" Foreground="#00ADB5" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="txtWins" Text="0" Foreground="#00ADB5" FontSize="40" FontWeight="Black" Margin="0,10,0,0"/>
                            <TextBlock x:Name="txtWinRate" Text="Win Rate: 0%" Foreground="#555" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- INPOSTORE DATUAK -->
                    <Border Grid.Column="2" Background="#2D2D2D" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="INPOSTOREA" Foreground="#FF5555" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="txtImpGames" Text="0" Foreground="#FF5555" FontSize="40" FontWeight="Black" Margin="0,10,0,0"/>
                            <TextBlock x:Name="txtImpWins" Text="Irabaziak: 0" Foreground="#885555" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. ATALA: ANALITIKA AURRERATUA (Diseinu berria) -->
                <TextBlock Text="JOKALARIAREN ESTILOA" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Opacity="0.8"/>

                <!-- DETEKTIBE SEN -->
                <Border Background="#252526" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#333" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🕵️" FontSize="24" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="15,0">
                            <TextBlock Text="DETEKTIBE SEN" Foreground="#00ADB5" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="Inpostorea asmatzeko gaitasuna bozketan." Foreground="Gray" FontSize="10" Margin="0,2,0,5"/>
                        </StackPanel>

                        <TextBlock x:Name="txtDetective" Grid.Column="2" Text="0%" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- MARTIRIA -->
                <Border Background="#252526" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#333" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="💀" FontSize="24" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="15,0">
                            <TextBlock Text="MARTIRIA" Foreground="#FF5555" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="Inozentea izanik kanporatua izan zaren aldia." Foreground="Gray" FontSize="10" Margin="0,2,0,5"/>
                        </StackPanel>

                        <TextBlock x:Name="txtMartyr" Grid.Column="2" Text="0" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- KAMUFLAJEA -->
                <Border Background="#252526" CornerRadius="8" Padding="15" BorderBrush="#333" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🥷" FontSize="24" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="15,0">
                            <TextBlock Text="KAMUFLAJEA" Foreground="#FFD700" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="Inpostore bezala biziraupen luzeena (Rondak)." Foreground="Gray" FontSize="10" Margin="0,2,0,5"/>
                        </StackPanel>

                        <TextBlock x:Name="txtCamo" Grid.Column="2" Text="0.0" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
