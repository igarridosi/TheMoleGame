<Window x:Class="Client.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="The Mole Game - Menua" Height="400" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1E1E1E">

    <Border Padding="30">
        <Grid>
            <!-- IZENBURUA -->
            <TextBlock Text="THE MOLE GAME" 
                       Foreground="#00ADB5" FontSize="30" FontWeight="Bold" 
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,20"/>

            <!-- 1. PANELA: BOTOI NAGUSIAK (Sortu / Sartu) -->
            <StackPanel x:Name="pnlMainButtons" VerticalAlignment="Center">

                <!-- SORTU PARTIDA -->
                <Button x:Name="btnCreateMode" Content="SORTU PARTIDA BERRIA" 
                        Height="50" Margin="0,0,0,20"
                        Background="#00ADB5" Foreground="White" FontWeight="Bold" FontSize="16"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnCreateMode_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- SARTU PARTIDARA -->
                <Button x:Name="btnJoinMode" Content="SARTU KODE BATEKIN" 
                        Height="50"
                        Background="#333333" Foreground="White" FontWeight="Bold" FontSize="16"
                        BorderBrush="#00ADB5" BorderThickness="2" Cursor="Hand"
                        Click="BtnJoinMode_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- 2. PANELA: PARTIDA SORTU (Kodea erakusten du) -->
            <StackPanel x:Name="pnlCreate" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="ZURE PARTIDAREN KODEA:" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <!-- KODEA -->
                <Border Background="#333333" CornerRadius="5" Padding="10" Margin="0,0,0,20" Width="200">
                    <TextBlock x:Name="lblRoomCode" Text="-----" 
                               Foreground="#FFD700" FontSize="32" FontWeight="Bold" 
                               HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Text="Eman kode hau lagunei." Foreground="#555" HorizontalAlignment="Center" Margin="0,0,0,20" FontStyle="Italic"/>

                <Button x:Name="btnContinueToLobby" Content="JARRAITU LOBBY-RA ->" 
                        Height="45" Width="250"
                        Background="#00ADB5" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnContinueToLobby_Click" Visibility="Collapsed">
                    <!-- Hasieran ezkutuan kodea jaso arte -->
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Atzera" Click="BtnBack_Click" Background="Transparent" Foreground="Gray" BorderThickness="0" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- 3. PANELA: SARTU PARTIDARA (Kodea eskatzen du) -->
            <StackPanel x:Name="pnlJoin" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="SARTU PARTIDAREN KODEA:" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBox x:Name="txtCodeInput" 
                         Height="45" Width="200" 
                         FontSize="24" FontWeight="Bold" CharacterCasing="Upper"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Background="#333333" Foreground="White" BorderBrush="#00ADB5"
                         Margin="0,0,0,20" MaxLength="5"/>

                <Button x:Name="btnJoinGame" Content="SARTU ORAIN" 
                        Height="45" Width="200"
                        Background="#00ADB5" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnJoinGame_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Atzera" Click="BtnBack_Click" Background="Transparent" Foreground="Gray" BorderThickness="0" Margin="0,10,0,0"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
