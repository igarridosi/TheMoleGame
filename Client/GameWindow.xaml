<Window x:Class="Client.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="The Mole - Lobby" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0. ILARA: Moderatzaile Panela (Behar denean agertuko da) -->
            <RowDefinition Height="*"/>
            <!-- 1. ILARA: Jokoa bera (Jokalariak eta Chat) -->
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Ezkerra: Jokalariak -->
            <ColumnDefinition Width="*"/>
            <!-- Eskuma: Chat eta Jokoa -->
        </Grid.ColumnDefinitions>

        <!-- MODERATZAILE PANELA (Goian) -->
        <Border x:Name="pnlModerator" 
                Grid.Row="0" Grid.ColumnSpan="2"
                Background="#2A0000" 
                BorderBrush="#FF4444" 
                BorderThickness="0,0,0,1"
                Padding="15,5"
                Visibility="Collapsed">
            <!-- Hasieran ezkutuan -->

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TITULUA -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ MODERATOR CONTROLS" 
                               Foreground="#FF5555" 
                               FontWeight="Bold" 
                               FontSize="14" 
                               VerticalAlignment="Center" 
                               Margin="0,0,20,0"/>
                </StackPanel>

                <!-- BOTOIAK (Eskuman) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">

                    <!-- PAUSE (Laranja) -->
                    <Button Content="⏸ PAUSE" Click="BtnPause_Click"
                            Background="Transparent" Foreground="#FFAA00" FontWeight="Bold"
                            BorderBrush="#FFAA00" BorderThickness="1"
                            Padding="10,5" Margin="5,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="1" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#332200"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- ANNOUNCE (Urdina) -->
                    <Button Content="📢 ANNOUNCE" Click="BtnAnnounce_Click"
                            Background="Transparent" Foreground="#00ADB5" FontWeight="Bold"
                            BorderBrush="#00ADB5" BorderThickness="1"
                            Padding="10,5" Margin="5,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="1" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#002222"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- SKIP (Gorria) -->
                    <Button Content="⏩ SKIP ROUND" Click="BtnSkip_Click"
                            Background="#FF4444" Foreground="White" FontWeight="Bold"
                            BorderThickness="0"
                            Padding="10,5" Margin="5,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#CC0000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- BOTOI BERRIA: ERABILTZAILEAK KUDEATU (Morea adibidez) -->
                    <Button Content="👥 USERS" Click="BtnManageUsers_Click"
                            Background="Transparent" Foreground="#DDA0DD" FontWeight="Bold"
                            BorderBrush="#DDA0DD" BorderThickness="1"
                            Padding="10,5" Margin="5,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="1" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#220022"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>
        <!-- EZKERRALDEA: JOKALARI ZERRENDA -->
        <Border Grid.Row="1" Grid.Column="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="JOKALARIAK" Foreground="#00ADB5" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <!-- Jokalarien zerrenda -->
                <ListBox x:Name="lstPlayers" Grid.Row="1" 
                         Foreground="White"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <!-- 1. HAU DA BERRIA: ListBox-aren beraren ESTILOA (Atzealde zuria kentzeko) -->
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>

                            <!-- Plantilla berridatzi behar da Windows-ek koloreak ez aldatzeko -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBox">
                                        <Border x:Name="Bd" 
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="1">
                                            <ScrollViewer Focusable="False">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- DESGAITZEAN: Atzealdea gardena mantendu eta Opazitatea jeitsi -->
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                                <Setter Property="Opacity" Value="0.5"/>
                                                <!-- Hemen erregulatzen da gardentasuna -->
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        </ListBox.Style>

                        <!-- 2. HAU LEHENGOA DA: Elementu bakoitzaren estiloa (Txartelak) -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,4,0,4"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>

                            <!-- BERRIA: Honek ilara bera ez-fokalizagarria egiten du. 
                                 Horrela klik egitean ez da "aukeratua" geratzen, 
                                 baina barruko botoiak funtzionatzen jarraitzen du. -->
                            <Setter Property="Focusable" Value="False"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" 
                                                Background="#333333" 
                                                CornerRadius="6"
                                                Padding="8">
                                            <ContentPresenter />
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <!-- Sagua gainean jartzean (Hover) - Hau mantendu dezakegu efektu polita delako -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#444444"/>
                                            </Trigger>

                                            <!-- KENDUTA: IsSelected Trigger-a ezabatu dugu.
                                                 Lehen hemen zegoen borde urdina jartzen zuen kodea.
                                                 Kenduta, klik egitean ez da ezer gertatzen. -->

                                            <!-- Kanporatua (Desgaituta) -->
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#222222"/>
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!-- 3. Zure ItemTemplate (Datuak nola ikusi) -->
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Txanda -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Izena -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Hitza -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Botoia -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Txanda Zirkulua -->
                                    <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTurn}" Value="True">
                                                        <Setter Property="Fill" Value="#00ADB5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- Izena -->
                                    <TextBlock Grid.Column="1" Text="{Binding Username}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEliminated}" Value="True">
                                                        <Setter Property="Foreground" Value="#888888"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Hitza -->
                                    <TextBlock Grid.Column="2" Text="{Binding SubmittedWord}" FontStyle="Italic" Foreground="#FFD700" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,10,0"/>

                                    <!-- Botoia -->
                                    <Button Grid.Column="3" Content="BOTATU" Background="#FF5555" Foreground="White" FontSize="10" Padding="8,2" Click="BtnVote_Click" Tag="{Binding Username}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVotingPhase}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                </ListBox>

                <!-- Admin Botoiak -->
                <StackPanel Grid.Row="2" Margin="0,10,0,10">
                    <Button x:Name="btnProfile" 
                            Content="👤 NIRE PROFILA" 
                            Height="30" Margin="0,10,0,0"
                            Background="#333333" Foreground="#00ADB5" 
                            BorderBrush="#00ADB5" BorderThickness="1"
                            Click="BtnProfile_Click"/>
                    <Button x:Name="btnAdminWords" 
                        Content="+ HITZA GEHITU" 
                        Height="30" Margin="0,0,0,15"
                        Background="#444444" Foreground="White"
                        Visibility="Collapsed" 
                        Click="BtnAdminWords_Click"/>
                    <Button x:Name="btnStartGame" 
                            Content="HASI PARTIDA" 
                            Height="40" 
                            Background="#FF5555" 
                            Foreground="White" 
                            FontWeight="Bold"
                            BorderThickness="0"
                            Visibility="Collapsed" 
                            Click="BtnStartGame_Click"/>
                    <!-- Visibility="Collapsed": Bakarrik Adminak ikusiko du -->
                    <!-- REMATCH Botoia -->
                    <Button x:Name="btnRestart" 
                            Content="PARTIDA BERRIA SORTU" 
                            Height="40" 
                            Background="#00ADB5" 
                            Foreground="White" 
                            FontWeight="Bold"
                            BorderThickness="0"
                            Visibility="Collapsed" 
                            Click="BtnRestart_Click"
                            Margin="0,5,0,0"/>
                </StackPanel>
                
            </Grid>
        </Border>

        <!-- ESKUMALDEA: CHAT ETA JOKO EREMUA -->
        <Grid Grid.Row="2" Grid.Column="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Izenburua -->
                <RowDefinition Height="*"/>
                <!-- Chat Historia -->
                <RowDefinition Height="Auto"/>
                <!-- Input -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Ronda Info -->
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="GELA NAGUSIA" Foreground="White" FontSize="20" FontWeight="Light"/>
                    <TextBlock x:Name="lblUserInfo" Text="..." Foreground="Gray" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>


                <!-- RONDA KONTAGAILUA -->
                <Border Grid.Column="1" Background="#333333" CornerRadius="5" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <!-- RONDA -->
                        <TextBlock Text="RONDA: " Foreground="Gray" FontWeight="Bold"/>
                        <TextBlock x:Name="lblRoundInfo" Text="1 / 3" Foreground="#00ADB5" FontWeight="Bold" Margin="0,0,15,0"/>

                        <!-- ERLOJUA (BERRIA) -->
                        <TextBlock Text="⏱ " Foreground="White"/>
                        <TextBlock x:Name="lblTimer" Text="--" Foreground="#FF5555" FontWeight="Bold" Width="25"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- Chat Historia -->
            <Border Grid.Row="1" Background="#2D2D2D" CornerRadius="5" Padding="5">
                <ScrollViewer x:Name="scrollChat">
                    <StackPanel x:Name="pnlChatMessages">
                        <!-- Mezuak hemen gehituko dira -->
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Input Eremua -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtMessage" 
                         Height="40" 
                         Padding="5" 
                         VerticalContentAlignment="Center"
                         Background="#2D2D2D" 
                         Foreground="White" 
                         BorderBrush="#00ADB5"
                         KeyDown="TxtMessage_KeyDown"/>

                <Button x:Name="btnSend" 
                        Grid.Column="1" 
                        Content="BIDALI" 
                        Background="#00ADB5" 
                        Foreground="White" 
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="5,0,0,0"
                        Click="BtnSend_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
