<Window x:Class="Client.AdminUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="Erabiltzaile Kudeaketa" Height="500" Width="700"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">
    <Window.Resources>
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" 
                        Grid.ColumnSpan="2"
                        CornerRadius="2"
                        Background="#333333"
                        BorderBrush="#444444"
                        BorderThickness="1" />
                <Border Grid.Column="0"
                        CornerRadius="2,0,0,2" 
                        Margin="1" 
                        Background="#333333" 
                        BorderBrush="#444444"
                        BorderThickness="0,0,1,0" />
                <Path x:Name="Arrow"
                      Grid.Column="1"     
                      Fill="White"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>
        </ControlTemplate>
        <!-- ESTILO BERRIA: Goiburuak (Headers) Ilunak -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#00ADB5"/>
            <!-- Turkesa -->
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ERABILTZAILEEN KUDEAKETA" Foreground="#00ADB5" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- DATAGRID -->
        <DataGrid x:Name="gridUsers" Grid.Row="1" AutoGenerateColumns="False" 
                  Background="#252526" 
                  RowBackground="#2D2D2D" 
                  AlternatingRowBackground="#333333"
                  Foreground="White" 
                  BorderBrush="#444444" BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#444444"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  IsReadOnly="True">

            <!-- ESTILOAK ZUTABEENTZAT -->
            <DataGrid.Resources>
                <!-- 1. Estiloa Testuarentzat: Ezkerrera eta Bertikalki Erdian -->
                <Style x:Key="LeftCenterAlign" TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="10,0,0,0"/>
                    <!-- Pixka bat banantzeko ertzetik -->
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!-- ID (Irakurtzeko bakarrik) -->
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"
                                    ElementStyle="{StaticResource LeftCenterAlign}"/>

                <!-- ERABILTZAILEA (Irakurtzeko bakarrik) -->
                <DataGridTextColumn Header="Erabiltzailea" Binding="{Binding Username}" Width="*" IsReadOnly="True"
                                    ElementStyle="{StaticResource LeftCenterAlign}"/>

                <!-- ROLA ZUTABEA -->
                <DataGridTemplateColumn Header="Rola" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- MODERATZAILEA (Testua) -->
                                <TextBlock x:Name="txtRoleMod" Text="{Binding Role}" Foreground="#00ADB5" FontWeight="Bold" 
                                           VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>

                                <!-- COMBOBOX PERTSONALIZATUA -->
                                <ComboBox x:Name="cmbRole"
                                          SelectedItem="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AvailableRoles}"
                                          DropDownClosed="CmbRole_DropDownClosed"
                                          Height="25" 
                                          VerticalContentAlignment="Center" 
                                          Visibility="Visible"
                                          Background="#333333"
                                          Foreground="White"
                                          BorderThickness="0">

                                    <ComboBox.Resources>
                                        <!-- Popup atzealdea beltza jartzeko -->
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#333333"/>
                                    </ComboBox.Resources>

                                    <!-- ITEM ESTILOA (Dropdown barrukoa) -->
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="#333333"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#00ADB5"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#444444"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>

                                    <!-- TEMPLATE BERRIA (Hau da gakoa zuri-a kentzeko) -->
                                    <ComboBox.Template>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Grid>
                                                <!-- Gezia (Eskuman) -->
                                                <ToggleButton Name="ToggleButton" 
                                                              Template="{StaticResource ComboBoxToggleButton}" 
                                                              Grid.Column="2" 
                                                              Focusable="false"
                                                              IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                              ClickMode="Press"/>

                                                <!-- Aukeratutako testua (Ezkerrean) -->
                                                <ContentPresenter Name="ContentSite" 
                                                                  IsHitTestVisible="False" 
                                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                  Margin="10,0,23,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left" />

                                                <!-- Dropdown leihoa -->
                                                <Popup Name="Popup"
                                                       Placement="Bottom"
                                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                                       AllowsTransparency="True" 
                                                       Focusable="False"
                                                       PopupAnimation="Slide">
                                                    <Grid Name="DropDown"
                                                          SnapsToDevicePixels="True"                
                                                          MinWidth="{TemplateBinding ActualWidth}"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                        <Border x:Name="DropDownBorder"
                                                                Background="#333333"
                                                                BorderThickness="1"
                                                                BorderBrush="#444444"/>
                                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </ComboBox.Template>
                                </ComboBox>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Role}" Value="Moderator">
                                    <Setter TargetName="txtRoleMod" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="cmbRole" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- AKZIOAK (Lehengoa bezala) -->
                <DataGridTemplateColumn Header="Akzioak" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="BtnToggleBan_Click" 
                                    FontWeight="Bold" FontSize="11" 
                                    Margin="5" Padding="5,2" 
                                    Cursor="Hand" BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="UNBAN (Gaitu)"/>
                                        <Setter Property="Background" Value="#00C853"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Visibility" Value="Visible"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBanned}" Value="False">
                                                <Setter Property="Content" Value="BAN (Blokeatu)"/>
                                                <Setter Property="Background" Value="#FF4444"/>
                                            </DataTrigger>

                                            <!-- Moderatzailea bada, botoia ezkutatu -->
                                            <DataTrigger Binding="{Binding Role}" Value="Moderator">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- BOTOIAK BEHEAN -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- REFRESH -->
            <Button Content="↻ ZERRENDA FRESKATU" Click="BtnRefresh_Click" 
                    Height="40" Margin="0,0,5,0"
                    Background="#333333" Foreground="#00ADB5" FontWeight="Bold" BorderBrush="#00ADB5"/>

            <!-- SORTU BERRIA (BERRIA) -->
            <Button Grid.Column="1" Content="+ ERABILTZAILEA SORTU" Click="BtnCreateUser_Click" 
                    Height="40" Margin="5,0,0,0"
                    Background="#00ADB5" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
