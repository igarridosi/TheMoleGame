<Window x:Class="Client.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="The Mole - Menua" Height="450" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1E1E1E">

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0: Izenburua -->
                <RowDefinition Height="*"/>
                <!-- 1: Edukia -->
            </Grid.RowDefinitions>

                
            <!-- IZENBURUA (Beti goian) -->
            <TextBlock Text="THE MOLE GAME" Grid.Row="0" x:Name="tbTitle"
                        Foreground="#00ADB5" FontSize="42" FontWeight="Bold" 
                        HorizontalAlignment="Center" Margin="0,25,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#00ADB5" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                </TextBlock.Effect>
            </TextBlock>


            <!-- ========================================================= -->
            <!-- 1. PANELA: BOTOI NAGUSIAK -->
            <!-- ========================================================= -->
            <StackPanel x:Name="pnlMainButtons" Grid.Row="1" VerticalAlignment="Center">
                <Button Content="SORTU PARTIDA BERRIA" Height="55" Margin="0,0,0,20"
                        Background="#00ADB5" Foreground="White" FontWeight="Bold" FontSize="16"
                        BorderThickness="0" Cursor="Hand" Click="BtnCreateMode_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#008C93"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="SARTU KODE BATEKIN" Height="55"
                        Background="Transparent" Foreground="White" FontWeight="Bold" FontSize="16"
                        BorderBrush="#00ADB5" BorderThickness="2" Cursor="Hand" Click="BtnJoinMode_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#222"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- ========================================================= -->
            <!-- 2. PANELA: PARTIDA SORTU (Kodea) -->
            <!-- ========================================================= -->
            <Grid x:Name="pnlCreate" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="ZURE PARTIDAREN KODEA:" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <!-- KODEAREN KAXA (KLIKAGARRIA) -->
                <Border x:Name="brdCodeBox" Grid.Row="1"
                        Background="#252526" CornerRadius="10" Margin="0,0,0,10" Width="280" Height="90"
                        Cursor="Hand" MouseLeftButtonDown="CodesBox_Click"
                        BorderBrush="Transparent" BorderThickness="2">

                    <Grid>
                        <!-- KODEA (Hasieran ikusgai) -->
                        <TextBlock x:Name="lblRoomCode" Text="-----" 
                                   Foreground="#FFD700" FontSize="42" FontWeight="Black" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Visible"/>

                        <!-- MEZUA (Hasieran ezkutuan) -->
                        <StackPanel x:Name="pnlCopiedMessage" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock Text="✅" FontSize="24" HorizontalAlignment="Center" Foreground="#00ADB5" Margin="0,0,0,5"/>
                            <TextBlock Text="KOPIATUTA!" Foreground="#00ADB5" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#333333"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <TextBlock Grid.Row="2" Text="Egin klik kodean kopiatzeko." Foreground="#555" HorizontalAlignment="Center" Margin="0,0,0,30" FontStyle="Italic" FontSize="12"/>

                <Button x:Name="btnContinueToLobby" Grid.Row="3" Content="JARRAITU LOBBY-RA  ➜" 
                        Height="50" Width="280" Background="#00ADB5" Foreground="White" FontWeight="Bold" FontSize="14"
                        BorderThickness="0" Cursor="Hand" Click="BtnContinueToLobby_Click" Visibility="Collapsed">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                
            </Grid>

            <!-- ========================================================= -->
            <!-- 3. PANELA: SARTU PARTIDARA -->
            <!-- ========================================================= -->
            <StackPanel x:Name="pnlJoin" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="SARTU PARTIDAREN KODEA:" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <TextBox x:Name="txtCodeInput" Height="50" Width="220" 
                         FontSize="28" FontWeight="Bold" CharacterCasing="Upper"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Background="#252526" Foreground="White" BorderBrush="#00ADB5" 
                         CaretBrush="White" Margin="0,0,0,25" MaxLength="5"/>

                <Button x:Name="btnJoinGame" Content="SARTU ORAIN" Height="50" Width="220"
                        Background="#00ADB5" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Click="BtnJoinGame_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Atzera" Click="BtnBack_Click" Width="50" Background="Transparent" Foreground="Gray" BorderThickness="0" Margin="0,15,0,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="2"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- 4. PANELA: MODERATZAILEA -->
            <StackPanel x:Name="pnlModeratorRooms" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="PARTIDA AKTIBOAK:" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>

                <ListBox x:Name="lstRooms" Height="180" 
                         Background="Transparent" BorderThickness="0"
                         Foreground="White" Margin="0,0,0,20"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- TXARTEL DISEINUA -->
                            <Border Background="#2D2D2D" CornerRadius="8" Padding="12,8" Margin="0,4,0,4"
                                    BorderBrush="#444" BorderThickness="1" Cursor="Hand">

                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- KODEA -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- HOST -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- KOPURUA -->
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. KODEA (Ezkerraldean) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="#" Foreground="Gray" FontWeight="Bold" FontSize="14" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding Code}" Foreground="#FFD700" FontWeight="Black" FontSize="18"/>
                                    </StackPanel>

                                    <!-- 2. HOST IZENA (Erdian) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                        <TextBlock Text="👑" FontSize="12" Margin="0,0,5,0" ToolTip="Gela sortzailea"/>
                                        <TextBlock Text="{Binding Host}" Foreground="#EEE" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>

                                    <!-- 3. JOKALARI KOPURUA (Eskuinaldean) -->
                                    <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👥" FontSize="10" Foreground="#00ADB5" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding PlayerCount}" Foreground="#00ADB5" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Hover Efektua (Style bidez hobeto legoke, baina hemen sinple) -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#383838"/>
                                                <Setter Property="BorderBrush" Value="#00ADB5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="SARTU HAUTATUTAKOAN" Click="BtnJoinSelected_Click" Height="45" Background="#00ADB5" Foreground="White" FontWeight="Bold" Margin="0,0,0,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="➕ SORTU TEST PARTIDA" Click="BtnCreateTestGame_Click" Height="45" Background="#FF6B35" Foreground="White" FontWeight="Bold" Margin="0,0,0,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="↻ ZERRENDA FRESKATU" Click="BtnRefreshRooms_Click" Height="35" Background="Transparent" Foreground="Gray" BorderBrush="Gray" BorderThickness="1">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</Window>
