<Window x:Class="Client.RankingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Client"
    mc:Ignorable="d"
    Title="Ranking Orokorra" Height="700" Width="850"
    WindowStartupLocation="CenterScreen" Background="#1E1E1E">
<Window.Resources>
    <!-- ESTILO BERRIA: Goiburuak (Headers) Ilunak -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#333333"/>
        <Setter Property="Foreground" Value="#00ADB5"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderBrush" Value="#444444"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
</Window.Resources>
<Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titulua -->
            <RowDefinition Height="Auto"/>
            <!-- Txartelak (Dashboard) -->
            <RowDefinition Height="*"/>
            <!-- Ranking Zerrenda -->
            <RowDefinition Height="Auto"/>
            <!-- Metrika Titulua -->
            <RowDefinition Height="*"/>
            <!-- Metrika Zerrenda -->
            <RowDefinition Height="Auto"/>
            <!-- Botoia -->
        </Grid.RowDefinitions>

        <!-- TITULUA -->
        <TextBlock Text="ESTATISTIKA OROKORRAK" Foreground="#00ADB5" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,0,0,20"/>

        <!-- DASHBOARD (TXARTELAK) -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. PARTIDAK -->
            <Border Grid.Column="0" Background="#2D2D2D" CornerRadius="8" Padding="15" Margin="0,0,10,0" Height="105" VerticalAlignment="Bottom">
                <StackPanel>
                    <TextBlock Text="PARTIDAK GUZTIRA" Foreground="Gray" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="txtTotalGames" Text="0" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock Text="Jokatuta partidak" Foreground="#555" FontSize="10"/>
                </StackPanel>
            </Border>

            <!-- 2. INPOSTORE ONENA -->
            <Border Grid.Column="1" Background="#2D2D2D" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="INPOSTORE ONENA" Foreground="#FF5555" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="txtTopImpostor" Text="---" Foreground="#FF5555" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBlock x:Name="txtTopWins" Text="0 garaipen" Foreground="#885555" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- 3. OREKA (Barra) -->
            <Border Grid.Column="2" Background="#2D2D2D" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="JOKOAREN OREKA" Foreground="#00ADB5" FontSize="11" FontWeight="Bold"/>

                    <!-- Barra Grafikoa Simulatua -->
                    <Grid Height="20" Margin="0,15,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" x:Name="colImp"/>
                            <ColumnDefinition Width="*" x:Name="colCiv"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FF5555" CornerRadius="4,0,0,4" ToolTip="Inpostoreak"/>
                        <Border Grid.Column="1" Background="#00ADB5" CornerRadius="0,4,4,0" ToolTip="Herritarrak"/>
                    </Grid>

                    <DockPanel>
                        <TextBlock Text="Inpostoreak" Foreground="#FF5555" FontSize="10"/>
                        <TextBlock x:Name="txtBalance" Text="50% / 50%" Foreground="White" FontSize="10" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- RANKING ZERRENDA (DataGrid) -->
        <DataGrid x:Name="gridRanking" Grid.Row="2" 
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#252526" RowBackground="#2D2D2D" AlternatingRowBackground="#333333" HorizontalGridLinesBrush="#444444" Foreground="#00ADB5"
                  BorderThickness="0" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Jokalaria" Binding="{Binding Username}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Partidak" Binding="{Binding GamesPlayed}" Width="150"/>
                <DataGridTextColumn Header="Garaipenak" Binding="{Binding TotalWins}" Width="150"/>
                <DataGridTextColumn Header="Inp. Garaipenak" Binding="{Binding ImpostorWins}" Width="150"/>
                <DataGridTextColumn Header="Win Rate" Binding="{Binding WinRate}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- METRIKA AURRERATUEN TITULUA -->
        <StackPanel Grid.Row="3" Margin="0,15,0,10">
            <TextBlock Text="📶 METRIKA AURRERATUAK (Skill-ak)" Foreground="#00ADB5" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Jokalari bakoitzaren gaitasun zehatzak" Foreground="#666" FontSize="11"/>
        </StackPanel>

        <!-- METRIKA AURRERATUEN ZERRENDA -->
        <DataGrid x:Name="gridMetrics" Grid.Row="4" 
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#252526" RowBackground="#2D2D2D" AlternatingRowBackground="#333333" HorizontalGridLinesBrush="#444444" Foreground="#9B59B6"
                  BorderThickness="0" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Jokalaria" Binding="{Binding Username}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="🕵️ Detektibe" Binding="{Binding DetectiveScore}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#3498DB"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="💀 Martiria" Binding="{Binding MartyrScore}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#E74C3C"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="🥷 Kamuflajea" Binding="{Binding CamouflageScore}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#F39C12"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- PDF BOTOIA -->
        <Button x:Name="btnExportPdf" Grid.Row="5" 
                Content="📄 ESPORTATU PDF (TXOSTENA)" 
                Height="45" Margin="0,20,0,0"
                Background="#FF5555" Foreground="White" FontWeight="Bold"
                Visibility="Collapsed" Click="BtnExportPdf_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
