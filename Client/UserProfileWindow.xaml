<Window x:Class="Client.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="Nire Estatistikak" Height="450" Width="700" Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- EZKERRA: PERFILA -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <Border Width="100" Height="100" CornerRadius="50" Background="#333333" BorderBrush="#00ADB5" BorderThickness="2" Margin="0,0,0,15">
                <TextBlock Text="👤" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
            </Border>
            <TextBlock x:Name="lblUsername" Text="Erabiltzailea" FontSize="20" FontWeight="Bold" Foreground="#00ADB5" HorizontalAlignment="Center"/>
            <TextBlock Text="JOKALARIA" Foreground="Gray" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ESKUMA: ESTATISTIKAK -->
        <Grid Grid.Column="1" Margin="30,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="JOKOAREN HISTORIALA" Foreground="White" FontSize="22" FontWeight="Light" Margin="0,0,0,20"/>

            <WrapPanel Grid.Row="1">
                <!-- TXARTELA 1: PARTIDAK -->
                <Border Width="180" Height="110" Background="#2D2D2D" CornerRadius="10" Margin="0,0,15,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="PARTIDAK" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="txtGames" Text="0" Foreground="White" FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="Jokatuta" Foreground="#555555" FontSize="10"/>
                    </StackPanel>
                </Border>

                <!-- TXARTELA 2: GARAIPENAK -->
                <Border Width="180" Height="110" Background="#2D2D2D" CornerRadius="10" Margin="0,0,15,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="GARAIPENAK" Foreground="#00ADB5" FontSize="12"/>
                        <TextBlock x:Name="txtWins" Text="0" Foreground="#00ADB5" FontSize="36" FontWeight="Bold"/>
                        <TextBlock x:Name="txtWinRate" Text="Win Rate: 0%" Foreground="#555555" FontSize="10"/>
                    </StackPanel>
                </Border>

                <!-- TXARTELA 3: INPOSTORE -->
                <Border Width="180" Height="110" Background="#2D2D2D" CornerRadius="10" Margin="0,0,15,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="INPOSTORE" Foreground="#FF5555" FontSize="12"/>
                        <TextBlock x:Name="txtImpGames" Text="0" Foreground="#FF5555" FontSize="36" FontWeight="Bold"/>
                        <TextBlock x:Name="txtImpWins" Text="Irabaziak: 0" Foreground="#885555" FontSize="10"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
